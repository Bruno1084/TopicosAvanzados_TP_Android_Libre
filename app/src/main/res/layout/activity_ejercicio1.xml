<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:columnCount="2"
    android:gravity="center"
    tools:context=".ejercicio1.Ejercicio1Activity">

    <TextView android:text="Lista de Ejercicios"
        android:layout_columnSpan="2"
        android:textSize="30sp"
        android:layout_margin="20sp"/>

    <Button
        android:id="@+id/btn_ej1_fig1"
        android:text="Fig. 1 \n Formulario"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:gravity="center"
        android:layout_margin="8dp"/>

    <Button
        android:id="@+id/btn_ej1_fig2"
        android:text="Fig. 1 \n Tabla"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:gravity="center"
        android:layout_margin="8dp"/>

    <Button
        android:id="@+id/btn_ej1_fig3"
        android:text="Fig. 1 \n Lista"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:gravity="center"
        android:layout_margin="8dp"/>



</GridLayout>
