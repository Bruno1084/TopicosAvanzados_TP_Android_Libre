<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_obra_completa"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/obraNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="#000"
            android:textSize="16sp"
            android:background="#EEEEEE"
            android:text="Obra Nombre" />

        <TextView
            android:id="@+id/obraDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="#000"
            android:textSize="16sp"
            android:background="#EEEEEE"
            android:text="Obra Descripción" />

        <TextView
            android:id="@+id/obraFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="#000"
            android:textSize="16sp"
            android:background="#EEEEEE"
            android:text="Obra Fecha" />

        <TextView
            android:id="@+id/obraPrecioEstimado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="#000"
            android:textSize="16sp"
            android:background="#EEEEEE"
            android:text="Obra Precio Estimado" />

        <TextView
            android:id="@+id/obraDuenio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="#000"
            android:textSize="16sp"
            android:background="#EEEEEE"
            android:text="Obra Dueño" />
    </LinearLayout>
</LinearLayout>
